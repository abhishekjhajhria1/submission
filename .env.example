# Copy to .env and fill in.

# --- Default: Google Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Comma-separated failover chain (quotas are per model; overloaded models are skipped)
FARMHAND_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# Independent verifier on a DIFFERENT model family member: fewer shared blind spots, separate quota
FARMHAND_VERIFIER_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview
# Gemini 3 thinking level: minimal | low | medium | high (lower = faster steps)
LLM_THINKING=low

# --- Alternative: any OpenAI-compatible API (Groq, OpenRouter, OpenAI, Ollama...)
# FARMHAND_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# FARMHAND_MODEL=openai/gpt-oss-120b

# Seconds between LLM calls (free tiers allow ~10 requests/min). Lower it on a paid key.
LLM_MIN_INTERVAL=6
FARMHAND_PROFILE=patil_farms
