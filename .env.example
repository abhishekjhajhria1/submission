# Copy to .env and fill in.

# --- Default: Google Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
FARMHAND_MODEL=gemini-3.8-flash

# --- Alternative: any OpenAI-compatible API (Groq, OpenRouter, OpenAI, Ollama...)
# FARMHAND_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# FARMHAND_MODEL=openai/gpt-oss-120b

# Seconds between LLM calls (free tiers allow ~10 requests/min). Lower it on a paid key.
LLM_MIN_INTERVAL=6
FARMHAND_PROFILE=patil_farms
